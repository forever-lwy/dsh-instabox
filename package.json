{
  "name": "dsh-instabox",
  "version": "0.1.0",
  "description": "InstaBox cloud machines, live desktop and human takeover for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13",
    "dsh": "0.2.1-rc.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "docs": "node scripts/generate-reference.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@insforge/instabox-sdk": "0.6.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remote-access"
      ]
    }
  }
}
